# Tập A = {n ∈ N và n**2 + 2n chia hết cho 15}
def tap_A(limit):
    A = []
    for n in range(limit + 1):
        if (n**2 + 2*n) % 15 == 0:
            A.append(n)
    return set(A)
B = set(range(10001))  # {0,1,2,...,10000} 
A = tap_A(10000)
# Số phần tử của B \ A ( không trùng )
so_pt_B_tru_A = len(B - A)
#câu 1.2 Phần tử thứ 100 của A∩B(và) theo thứ tự giảm dần
AB = sorted(list(A & B), reverse=True)
phan_tu_thu_100 = AB[99] # index 99 = phần tử thứ 100
# Câu 1.3
# C = {n ∈ N, n là tích của hai số nguyên tố phân biệt}
def so_nguyen_to(x):
    if x < 2:
        return False
    if x % 2 == 0:
        return x == 2
    for i in range(3, int(math.sqrt(x)) + 1, 2):
        if x % i == 0:
            return False
    return True
# Tạo list số nguyên tố <= 5000
# số nguyên tố phải >= 2
# đ/k snt%1==0 và snt%snt == 0
numbers = [i for i in range(2, 5001) if so_nguyen_to(i)] 
def thuoc_C(n):
    for i in range(len(numbers)):
        for j in range(i+1, len(numbers)):
            if numbers[i] * numbers[j] == n:
                return True
            if numbers[i] * numbers[j] > n:
                break
    return False
# Tạo tập C (tới 10000)
C = set()
for i in range(2, 10001):
    if thuoc_C(i):
        C.add(i)
# Phần tử thứ 100 của C theo thứ tự tăng dần
C_sorted = sorted(list(C))
phan_tu_100_C = C_sorted[99]  # index 99 = phần tử thứ 100
